<?xml version="1.0" encoding="utf-8"?>
<package >
  <metadata>
    <id>$id$</id>
    <version>0.0.14</version>
    <title>RESTfulFoundation</title>
    <authors>dru@druware.com</authors>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="file">LICENSE.txt</license>
    <readme>README.md</readme>
    <!-- <icon>icon.png</icon> -->
    <projectUrl>https://github.com/Druware/RESTfulFoundation</projectUrl>
    <description>
        A set of foundation classes for quickly and easily building RESTful
        client applications and tools. Intended to be used primarily as base
        classes that provide a bridge from local logic to the server storage
        environment, the long term intent is to use these to build a light
        scaffolding tool that quickly builds the interfaces based upon this
        foundation, to enable rapid development of RESTful client applications.        
    </description>
    <releaseNotes>
        Added queryString to sync .Get on the Connection
        Added a Connection to all RESTObjects to enable a more streamlined use
    </releaseNotes>
    <copyright>Copyright 2022 - 2024 Druware Software Designs, All Rights Reserved</copyright>
    <tags>.net6 webapi</tags>
    <!-- The library has no package references; the empty group is what declares
         the supported framework. "nuget pack <csproj>" used to derive this, and
         the published 0.0.13/0.0.14 packages carry exactly this. Stating it
         keeps the package identical and silences NU5128 under dotnet pack. -->
    <dependencies>
      <group targetFramework="net8.0" />
    </dependencies>
  </metadata>
  <!-- Paths use forward slashes and name the assembly explicitly so that this
       nuspec is complete on its own. "nuget pack <csproj>" used to supply the
       assembly implicitly, but that is a Windows/mono tool; the CI workflow
       packs with "dotnet pack -p:NuspecFile=...", which takes the package
       contents from this list and nothing else. Without the lib entry below the
       published package contains the licence and readme and no code at all. -->
  <files>
    <file src="LICENSE.txt" target="" />
    <file src="README.md" target="" />
    <file src="bin/Release/net8.0/RESTfulFoundation.dll" target="lib/net8.0" />
  </files>
</package>
